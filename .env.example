# =============================================================================
# Ops Command Center — Environment Variables Configuration
# =============================================================================

# 1. Admin Authentication
ADMIN_PASSWORD=your_secure_password_here

# 2. PostgreSQL Database URL (Neon / Render / Supabase)
# Leave empty to use local database, or paste your PostgreSQL URL:
DATABASE_URL=postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require

# 3. Uptime Monitoring (UptimeRobot)
# Read-only API key from: https://uptimerobot.com/dashboard#mySettings
UPTIMEROBOT_API_KEY=ur123456-abcdef0123456789

# 4. TinyURL Project Redirects
# API Token from: https://tinyurl.com/app/settings/api
TINYURL_API_TOKEN=your_tinyurl_api_token_here

# 5. Render Accounts (Optional seed — can also be added via Control Panel UI)
RENDER_API_KEY=rnd_xxxxxxxxxxxx
RENDER_LABEL=Render - Main

# 6. Cloudflare Accounts (Optional seed — can also be added via Control Panel UI)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_LABEL=Cloudflare - Main

# 7. Custom Project Titles Override (Optional seed — can also be added via Control Panel UI)
# Format: alias:Custom Name, alias2:Custom Name 2
TINYURL_TITLES=rohanrarya:My Portfolio, predict:AI Predictor Model
