# =============================================================================
# Ops & Uptime Dashboard — Environment Variables Configuration
# =============================================================================

PORT=3000

# -----------------------------------------------------------------------------
# 1. UPTIMEROBOT (for Uptime Status Monitoring)
# Get your Read-Only API Key from: https://uptimerobot.com/dashboard#mySettings
# -----------------------------------------------------------------------------
UPTIMEROBOT_API_KEY=ur123456-abcdef0123456789

# -----------------------------------------------------------------------------
# 2. RENDER ACCOUNTS (for Live Git & Build Status)
# Get API Key from: Render Dashboard -> Account Settings -> API Keys
# NOTE: All services on each account are AUTO-DISCOVERED automatically!
# -----------------------------------------------------------------------------
# Single Account:
RENDER_API_KEY=rnd_xxxxxxxxxxxx
RENDER_LABEL=Render - Main

# Multiple Accounts (Option A — Numbered Variables, Recommended for Cloudflare Pages):
RENDER_API_KEY_1=rnd_xxxxxxxxxxxx
RENDER_LABEL_1=Render - Personal

RENDER_API_KEY_2=rnd_yyyyyyyyyyyy
RENDER_LABEL_2=Render - Studio/Client

# Multiple Accounts (Option B — Comma-separated):
# RENDER_API_KEYS=rnd_xxxxxxxxxxxx,rnd_yyyyyyyyyyyy

# -----------------------------------------------------------------------------
# 3. CLOUDFLARE ACCOUNTS (for Live Pages Deployments & Git Status)
# Account ID: In right sidebar of Cloudflare Dashboard
# API Token: My Profile -> API Tokens -> Create Token ("Edit Cloudflare Workers" template)
# NOTE: All Pages projects on each account are AUTO-DISCOVERED automatically!
# -----------------------------------------------------------------------------
# Single Account:
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_LABEL=Cloudflare - Main

# Multiple Accounts (Option A — Numbered Variables, Recommended for Cloudflare Pages):
CF_ACCOUNT_ID_1=your_first_cf_account_id
CF_API_TOKEN_1=your_first_cf_api_token
CF_LABEL_1=Cloudflare - Personal

CF_ACCOUNT_ID_2=your_second_cf_account_id
CF_API_TOKEN_2=your_second_cf_api_token
CF_LABEL_2=Cloudflare - Studio/Work

# -----------------------------------------------------------------------------
# 4. TINYURL (for Quick Launch Buttons & 1-Click Redirects)
# Get API Token from: https://tinyurl.com/app/settings/api
# Automatically fetches shortened links, aliases, and titles from your account
# -----------------------------------------------------------------------------
TINYURL_API_TOKEN=your_tinyurl_api_token_here

# -----------------------------------------------------------------------------
# 5. ADVANCED: ALL-IN-ONE JSON CONFIG (Alternative to individual keys above)
# -----------------------------------------------------------------------------
# DEPLOYMENTS_CONFIG={"render":[{"name":"Render 1","apiKey":"rnd_xxx"},{"name":"Render 2","apiKey":"rnd_yyy"}],"cloudflare":[{"name":"CF 1","accountId":"acc1","apiToken":"tok1"},{"name":"CF 2","accountId":"acc2","apiToken":"tok2"}]}

